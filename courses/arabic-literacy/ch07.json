      "front": {
        "ar": "",
        "en": "How do you read ٣٥ -- 35 or 53?"
      },
      "back": {
        "ar": "",
        "en": "35. Arabic digits run left to right with the biggest place first, exactly like English (٢٠٢٥ = 2025)."
      },
      "translit": "",
      "tags": [
        "reading-order"
      ],
      "source": "p. 127"
