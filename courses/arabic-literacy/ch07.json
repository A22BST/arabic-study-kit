    {
      "id": "ch07-c048",
      "front": {
        "ar": "",
        "en": "٠ zero vs the dot '.'"
      },
      "back": {
        "ar": "",
        "en": "Arabic zero ٠ is a small dot. Do not confuse it with the dot '.' used in numbers and mathematics."
      },
      "translit": "",
      "tags": [
        "look-alike"
      ],
      "source": "p. 128"
    },
    {
      "id": "ch07-c049",
      "front": {
        "ar": "",
        "en": "٥ vs English 0"
      },
      "back": {
        "ar": "",
        "en": "٥ is FIVE. Write it rounded so it is not mistaken for zero; Arabic zero is the dot ٠."
      },
      "translit": "",
      "tags": [
        "look-alike"
      ],
      "source": "pp. 128-132"
