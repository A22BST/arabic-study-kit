                "title": "11-19 · DIGIT + TEEN",
                "kicker": "unit name + عَشَر",
                "arFrom": "١٦",
                "ar": "سِتَّةَ عَشَر",
                "translit": "sit ta ta ʿa shar",
                "caption": "six + teen = **16**",
                "note": "Exception: ١١ = أَحَدَ عَشَر. Ten = عَشَرَة."
              },
              {
                "title": "20-90 · THE TENS",
                "kicker": "ending ـِين",
                "arFrom": "٥٠",
                "ar": "خَمْسِين",
                "translit": "kham siin",
                "caption": "five -> **fifty**",
                "note": "عِشْرِين · ثَلاثِين · أَرْبَعِين · سِتِّين · سَبْعِين · ثَمَانِين · تِسْعِين"
              },
              {
                "title": "21-99 · UNIT FIRST",
                "kicker": "unit + وَ + ten",
                "arFrom": "٥٣",
