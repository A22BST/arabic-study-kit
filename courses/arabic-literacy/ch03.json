    "exerciseGuide": [
      {
        "exercise": 1,
        "pages": "93",
        "task": "Circle every word containing a long vowel",
        "method": "Scan for one of the three **matching pairs**. A word still qualifies if it has at least one long vowel. Fatḥah + وْ / يْ (قَوْلَ, شَيْءُ) is aw / ay, not long.",
        "example": {
          "ar": "كِتَابْ",
          "translit": "ki taab",
          "note": "YES · contains تَا"
        },
        "contrast": {
          "ar": "دَرَسَ",
          "translit": "da ra sa",
          "note": "NO · only short a sounds"
        }
      },
      {
        "exercise": 2,
        "pages": "93-94",
        "task": "Add diacritics from the transcription, then circle long, short or both",
        "method": "The transcription tells you where the marks go. Circle **long** for aa / uu / ii and **short** for a short syllable; most words get **both**, like the book's example سَمِيعْ /sa miiʿ/.",
        "example": {
          "ar": "يَكْتُبُونْ",
          "translit": "yak tu buun",
          "note": "LONG + SHORT · both circled"
        },
        "contrast": {
          "ar": "يَسْمَعُ",
          "translit": "yas ma ʿu",
          "note": "SHORT only · no aa / uu / ii"
        }
      },
      {
        "exercise": 3,
        "pages": "95",
        "task": "Add the marks to an already written word",
        "method": "Keep the given letters. Use Latin **aa, uu, ii** to locate a long vowel, then put its matching mark on the letter before it. Fill in all other short vowels, sukuun and tanwiin too.",
        "example": {
          "ar": "كِتَابٌ",
          "translit": "ki taa bun",
          "note": "Book example · taa = تَا; -bun = بٌ"
        },
        "contrast": {
          "ar": "جَامِعَةٌ",
          "translit": "jaa mi ʿa tun",
          "note": "Item 4 · fatḥah on ج before ا"
        }
      },
      {
        "exercise": 4,
        "pages": "96",
        "task": "Write the Arabic word from Latin sounds",
        "method": "Write **both letters and vowel marks**, one syllable at a time. Long aa / uu / ii = the long-vowel letter, not a repeated short mark; a doubled consonant takes shaddah.",
        "example": {
          "ar": "مَكْتُوبٌ",
          "translit": "mak tuu bun",
          "note": "Item 9 · تُو = long uu"
        },
        "contrast": {
          "ar": "دَرَّسَ",
          "translit": "dar ra sa",
          "note": "Item 8 · rr = shaddah, no long vowel"
        }
      },
      {
        "exercise": 5,
        "pages": "97",
        "task": "Transcribe Arabic into Latin sounds",
        "method": "Read the visible marks and find the long vowel. Write **aa / uu / ii** as one prolonged sound; keep short vowels short. Shaddah splits across two syllables (naj jaa run).",
        "example": {
          "ar": "بُيُوتٍ",
          "translit": "bu yuu tin",
          "note": "Item 6 · يُو = consonant y + long uu"
        },
        "contrast": {
          "ar": "حَمَّامِي",
          "translit": "ḥam maa mii",
          "note": "Item 3 · long aa and final ii"
        }
