      "id": "ch03-c004",
      "front": {
        "ar": "",
        "en": "Does a long-vowel letter (ا و ي) carry its own diacritic?"
      },
      "back": {
        "ar": "",
        "en": "No. The letter before it carries the matching short vowel; the long-vowel letter itself stays bare."
      },
      "translit": "",
      "tags": [
        "rule"
      ],
      "source": "p. 87"
    },
    {
      "id": "ch03-c005",
      "front": {
        "ar": "",
        "en": "Can a long vowel be the first letter of a word?"
      },
      "back": {
        "ar": "",
        "en": "No. It must follow a consonant that carries the matching short vowel."
      },
      "translit": "",
      "tags": [
        "rule"
      ],
      "source": "p. 87"
    },
    {
      "id": "ch03-c006",
