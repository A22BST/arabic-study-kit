      "front": {
        "ar": "",
        "en": "Is a short vowel pronounced before or after its consonant?"
      },
      "back": {
        "ar": "بَ",
        "en": "After. بَ is /ba/, never /ab/."
      },
      "translit": "ba",
      "tags": [
