        "rule"
      ],
      "source": "p. 74"
    },
    {
      "id": "ch02-c014",
      "front": {
        "ar": "",
        "en": "Can sukuun be written on the first letter of a word?"
      },
      "back": {
        "ar": "",
        "en": "No. No Arabic word may start with a letter that has sukuun -- a word cannot start with a pure consonant."
      },
      "translit": "",
      "tags": [
        "sukuun",
        "rule"
