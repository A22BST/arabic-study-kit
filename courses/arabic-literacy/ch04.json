            "type": "cards",
            "columns": 3,
            "items": [
              {
                "title": "Free hamzah ء",
                "kicker": "/ʔ/ · glottal stop",
                "caption": "At a word's **end**, after a letter with **sukuun** (book's basic rule).",
                "ar": "شَيْء",
                "translit": "shayʔ"
              },
              {
                "title": "Hamzah on waaw ؤ",
                "kicker": "/ʔ/ · NOT /w/",
                "caption": "**Middle or end**; used when the letter before it has **ḍammah**.",
                "ar": "سُؤَالٌ",
                "translit": "su ʔaa lun"
              },
              {
                "title": "Hamzah on yaaʔ ئ",
                "kicker": "/ʔ/ · NOT /y/ · nabrah",
                "caption": "**Middle or end**; used after **kasrah**. The seat has **no dots**.",
                "ar": "قَارِئٌ",
                "translit": "qaa ri ʔun"
              }
            ]
          },
          {
            "type": "cards",
            "columns": 2,
            "items": [
              {
                "title": "Alif maqṣuurah ى",
                "kicker": "/aa/ · long aa",
                "caption": "**End only**; looks like yaaʔ but has **no dots**. Always preceded by **fatḥah**.",
                "ar": "جَرَى",
                "translit": "ja raa"
              },
              {
                "title": "Taaʔ marbuuṭah ة",
                "kicker": "/t/",
                "caption": "**End only**; two dots. Shapes: ة / ـة. Turns masculine nouns feminine.",
                "ar": "مَدْرَسَةٌ",
                "translit": "mad ra sa tun"
              }
            ]
          }
        ]
      },
